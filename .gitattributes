# Media: MP4 vía Git LFS (instalar: omarchy pkg add git-lfs)
*.mp4   filter=lfs diff=lfs merge=lfs -text
# El resto de media como binario (evita diff/merge de texto en blobs)
*.webm  binary
*.mov   binary
backgrounds/*.png  binary
backgrounds/*.jpg  binary
backgrounds/*.jpeg binary
backgrounds/*.webp binary

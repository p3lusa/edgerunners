# Media como binario (evita diff/merge de texto en blobs)
videos/*.mp4 filter=lfs diff=lfs merge=lfs -text
videos/*.webm   binary
videos/*.mov    binary
backgrounds/*.png  binary
backgrounds/*.jpg  binary
backgrounds/*.jpeg binary
backgrounds/*.webp binary
*.mp4   binary
*.webm  binary
# Cuando el media crezca mucho, pasa a Git LFS (instalar: omarchy pkg add git-lfs):
#   videos/*.mp4   filter=lfs diff=lfs merge=lfs -text
#   backgrounds/*  filter=lfs diff=lfs merge=lfs -text
